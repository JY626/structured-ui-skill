    "checkinSuccess": { "light": "#329E6A", "dark": "#63CA98" },
    "trophyGold": { "light": "#CE8E16", "dark": "#F4BE4F" },
    "warningAmber": { "light": "#B36818", "dark": "#F7C17C" },
    "destructive": { "light": "#DC4C46", "dark": "#F2736D" }
  },
  "layout": {
    "pagePadding": 16,
    "sectionSpacing": 16,
    "cardRadius": 22,
    "controlRadius": 14,
    "squircleRadius": 14,
    "dividerWidth": 0.5,
    "minTouchTarget": 44,
    "floatingFabSize": 56,
    "floatingDockClearance": 92
  },
  "motion": {
    "snappy": { "response": 0.30, "damping": 0.78, "durationMs": 280 },
    "bouncy": { "response": 0.36, "damping": 0.66, "durationMs": 360 },
    "gentle": { "response": 0.44, "damping": 0.84, "durationMs": 420 },
    "tabSwitch": { "easing": "cubic-bezier(0.22, 1, 0.36, 1)", "durationMs": 250 }
  }
